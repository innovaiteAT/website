---
import { de } from '../../i18n/de';
---

<section id="start" class="hero" aria-labelledby="start-title">
  <h1 id="start-title"><span class="ia-wordmark">innov<b>AI</b>te</span></h1>
  <p class="claim">{de.hero.claim}</p>
  <hr class="ia-rule" />
  <p class="ia-lead">{de.hero.lead}</p>
  <a class="ia-btn" href="#mitmachen">{de.cta}</a>
</section>

<style>
  .hero {
    min-height: calc(100vh - 72px);
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    padding: 64px var(--ia-gutter);
    background: linear-gradient(90deg, rgba(1, 3, 8, .85) 0%, rgba(1, 3, 8, 0) 62%), var(--ia-waves);
  }
  h1 { font-size: clamp(3.4rem, 9vw, 7rem); font-weight: 500; line-height: 1; margin: 0 0 .6rem; }
  /* FEST: Im Hero-Titel ist „AI“ weiß und nicht fett, also wie der Rest des Worts (Vorgabe des Vereins, D17). Das Logo bleibt unverändert. */
  h1 .ia-wordmark b { color: var(--ia-text); font-weight: inherit; }
  .claim { font-size: clamp(1.2rem, 2.4vw, 1.9rem); font-weight: 300; margin: 0; }
</style>

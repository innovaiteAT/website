---
import { getCollection } from 'astro:content';
import { de } from '../../i18n/de';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const groups = (['leitung', 'team', 'associates'] as const).map((key) => ({
  key,
  label: de.team.groups[key],
  members: team.filter((m) => m.data.group === key),
}));
---

<section id="team" class="ia-section" aria-labelledby="team-title">
  <div class="ia-container">
    <h2 id="team-title">{de.team.title}</h2>
    <p class="ia-lead">{de.team.lead}</p>
    {groups.map((group) => (
      <>
        <h3>{group.label}</h3>
        <ul class="ia-grid members">
          {group.members.map((m) => (
            <li class="ia-card">
              <p class="name">{m.data.name}</p>
              <p>{m.data.role}</p>
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</section>

<style>
  h3 { font-size: 1.3rem; font-weight: 600; margin: 2.5rem 0 1rem; }
  .members { list-style: none; padding: 0; margin: 0; }
  .name { color: var(--ia-text); font-weight: 600; margin-bottom: .25rem; }
</style>

---
import { getCollection } from 'astro:content';
import { de } from '../../i18n/de';

const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<section id="faq" class="ia-section" aria-labelledby="faq-title">
  <div class="ia-container narrow">
    <h2 id="faq-title">{de.faq.title}</h2>
    {faq.map((entry) => (
      <details>
        <summary><h3>{entry.data.question}</h3></summary>
        <p>{entry.data.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .narrow { max-width: 820px; }
  details { border-bottom: 1px solid var(--ia-border); }
  summary { cursor: pointer; list-style: none; padding: 1.25rem 2.5rem 1.25rem 0; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 1.6rem; color: var(--ia-cyan); }
  details[open] summary::after { content: '–'; }
  h3 { display: inline; font-size: 1.1rem; font-weight: 600; margin: 0; }
  p { color: var(--ia-text-soft); margin: 0 0 1.25rem; max-width: 65ch; }
</style>

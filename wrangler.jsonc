{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "innovaite-website",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APPLICATION_RECIPIENTS": "join@innovaite.at,raphael.zaehrer@innovaite.at,patrik.stachura@innovaite.at",
    "MAIL_FROM": "noreply@innovaite.at"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "innovaite-db",
      // Platzhalter für lokale Entwicklung. Die echte ID trägt die Projektleitung nach `wrangler d1 create` ein.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // TODO Projektleitung: send_email-Binding (Cloudflare Email Service) und Cron-Trigger für die 12-Monats-Löschung
}

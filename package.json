{
  "name": "innovaite-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply innovaite-db --local",
    "db:list": "wrangler d1 execute innovaite-db --local --command \"SELECT * FROM applications ORDER BY created_at DESC\"",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
}
